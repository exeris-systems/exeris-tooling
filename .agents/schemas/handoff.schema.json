{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handoff (exeris-tooling)",
  "description": "One agent passing work to another within exeris-tooling. Composed over the bundle base with role vocabulary narrowed to this repository's roles and closed.",
  "allOf": [
    {
      "$ref": "../vendor/exeris-agents-2.1.0/schemas/handoff.base.schema.json"
    },
    {
      "properties": {
        "from": {
          "enum": [
            "human",
            "exeris-tooling-router",
            "exeris-tooling-architect",
            "exeris-tooling-implementer",
            "exeris-tooling-codegen-verification",
            "exeris-tooling-docs-adr",
            "exeris-tooling-evaluator"
          ]
        },
        "to": {
          "enum": [
            "human",
            "exeris-tooling-router",
            "exeris-tooling-architect",
            "exeris-tooling-implementer",
            "exeris-tooling-codegen-verification",
            "exeris-tooling-docs-adr",
            "exeris-tooling-evaluator"
          ]
        }
      }
    }
  ],
  "unevaluatedProperties": false
}

# Maven
target/
# .mvn/ marks the reactor root for ${maven.multiModuleProjectDirectory}, which exeris-tooling-parent
# resolves config/ against; only the marker is tracked, local Maven configuration stays untracked.
.mvn/*
!.mvn/.gitkeep
*.versionsBackup

# Node
node_modules/
dist/
*.tsbuildinfo
.angular/

# IDE
.idea/
.vscode/
*.iml
*.iws
*.ipr

# OS
.DS_Store
Thumbs.db

# Logs
*.log
hs_err_pid*.log
hs_err_pid*.jfr
replay_pid*.log

# Claude
.claude/worktrees/

# Agents
.agents-state/

# The eval runner's report. A run is evidence for one pull request, not repository content, and it
# carries a timestamp that would make every run a diff.
working-notes/eval-report.json


{
  "name": "@exeris/codegen-ts",
  "version": "0.9.0",
  "description": "Exeris front-end generator: emits an Angular 22 application from Exeris domain metadata",
  "keywords": [
    "exeris",
    "codegen",
    "code-generator",
    "angular",
    "angular-22",
    "typescript",
    "zod",
    "cli"
  ],
  "homepage": "https://github.com/exeris-systems/exeris-tooling/tree/main/exeris-codegen-ts#readme",
  "bugs": {
    "url": "https://github.com/exeris-systems/exeris-tooling/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exeris-systems/exeris-tooling.git",
    "directory": "exeris-codegen-ts"
  },
  "license": "Apache-2.0",
  "author": "Exeris Team",
  "type": "module",
  "bin": {
    "exeris-gen": "./dist/index.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "check:version": "node scripts/check-version-lockstep.mjs",
    "test:watch": "vitest",
    "test:coverage": "node scripts/coverage-gate.mjs",
    "verify:generated": "npm run build && node scripts/verify-generated-frontend.mjs",
    "lint": "eslint src/**/*.ts",
    "clean": "rimraf dist",
    "prepack": "npm run clean && npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "picocolors": "^1.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.9",
    "@vitest/coverage-v8": "^4.1.6",
    "rimraf": "^6.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}

<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0
                              https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <!--
    Publishing credentials for release.yml, and nothing else. It names no repository: every
    dependency of this reactor resolves from Maven Central, as it does for a consumer of the
    published POMs, so a build needs no settings file at all.

    Credentials arrive from the environment, never from this file.
  -->
  <servers>
    <!--
      Maven Central (the Central Portal). A USER TOKEN generated at central.sonatype.com/usertoken,
      not the account password. The id must match <publishingServerId> in the root POM's `release`
      profile.
    -->
    <server>
      <id>central</id>
      <username>${env.CENTRAL_TOKEN_USERNAME}</username>
      <password>${env.CENTRAL_TOKEN_PASSWORD}</password>
    </server>
  </servers>
</settings>

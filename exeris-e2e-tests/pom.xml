<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.exeris.tooling</groupId>
        <artifactId>exeris-tooling-parent</artifactId>
        <version>0.7.0-SNAPSHOT</version>
        <relativePath>../exeris-tooling-parent</relativePath>
    </parent>

    <artifactId>exeris-e2e-tests</artifactId>
    <packaging>jar</packaging>

    <name>Exeris Tooling :: E2E Tests</name>
    <description>
        End-to-end tests for the codegen pipeline: feed sample DomainMetadata
        through generators, assert kernel-target output shape and content.
        Heavyweight runtime integration tests (Postgres, RestAssured) live in
        downstream platform/integration-test repos, not here.
    </description>

    <properties>
        <!-- Declared empty so surefire's @{argLine} below still resolves when JaCoCo's
             prepare-agent is skipped (-Djacoco.skip=true); with the agent active it is
             overwritten by prepare-agent and both flags compose. -->
        <argLine></argLine>
    </properties>

    <dependencies>
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-sdk-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-sdk-source-model</artifactId>
        </dependency>
        <dependency>
            <groupId>eu.exeris.tooling</groupId>
            <artifactId>exeris-codegen-core</artifactId>
        </dependency>
        <dependency>
            <groupId>eu.exeris.tooling</groupId>
            <artifactId>exeris-codegen-java</artifactId>
        </dependency>

        <!-- G3 starts from annotated sources, so the real annotation processor runs
             inside the test's javac invocation rather than being simulated. -->
        <dependency>
            <groupId>eu.exeris.tooling</groupId>
            <artifactId>exeris-processor</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Real Open-Core Kernel SPI on the test classpath: the codegen
             compile-test verifies emitted code resolves against actual
             exeris-kernel-spi types instead of legacy local stubs. -->
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-kernel-spi</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Open-Core Kernel CORE — KernelBootstrap + HttpRouter for the
             Application/RuntimeLifecycle compile gate. -->
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-kernel-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- SDK boot conductor (G2): the compile gate emits a composed
             Application whose boot callback drives CompositionConductor —
             javac needs the real type, not a stub. -->
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-sdk-composition-runtime</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- G3: a real kernel around the conductor run — the community driver supplies the
             HTTP provider, the testkit fixture boots it on a loopback port (http subsystem
             only; no database is involved). -->
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-kernel-community</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-kernel-community-testkit</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Jackson 3 (tools.jackson) on the test classpath, for the emitted
             REPOSITORY, not the handler: KernelRepositoryGenerator persists
             List<X> fields as JSON columns through ObjectMapper/TypeReference,
             and is the only emitter that names tools.jackson. Handlers stopped
             naming it at ADR-036, which moved request-body decode to the
             HttpRequestBodyDecoder SPI. Version managed via exeris-tooling-bom
             (jackson3.version). -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- T2: the generated-test gate runs the emitted tests in-process. -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- No preview flag. G3 EXECUTES kernel classes rather than only compiling
                         against them, which is why one was here: kernel 0.10.2 shipped
                         preview-stamped classes (9 of them in exeris-kernel-core), and a
                         preview-stamped class will not load without it.

                         Kernel 0.11.0 ships none — measured, 0 stamps across spi/core/community/
                         community-testkit at class-file major 69 (kernel ADR-066). So the U0 pin
                         bump removed this flag's only reason to exist, and it goes with it rather
                         than lingering behind a comment that stopped being true. -->
                    <argLine>@{argLine}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.exeris.tooling</groupId>
        <artifactId>exeris-tooling-parent</artifactId>
        <version>0.9.0-SNAPSHOT</version>
        <relativePath>../exeris-tooling-parent</relativePath>
    </parent>

    <artifactId>exeris-e2e-tests</artifactId>
    <packaging>jar</packaging>

    <name>Exeris Tooling :: E2E Tests</name>
    <description>
        End-to-end tests for the codegen pipeline: feed sample DomainMetadata
        through generators, assert kernel-target output shape and content.
        Heavyweight runtime integration tests (Postgres, RestAssured) live in
        downstream platform/integration-test repos, not here.
    </description>

    <properties>
        <!-- Declared empty so surefire's @{argLine} below still resolves when JaCoCo's
             prepare-agent is skipped (-Djacoco.skip=true); with the agent active it is
             overwritten by prepare-agent and both flags compose. -->
        <argLine></argLine>
    </properties>

    <dependencies>
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-sdk-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-sdk-source-model</artifactId>
        </dependency>
        <dependency>
            <groupId>eu.exeris.tooling</groupId>
            <artifactId>exeris-codegen-core</artifactId>
        </dependency>
        <dependency>
            <groupId>eu.exeris.tooling</groupId>
            <artifactId>exeris-codegen-java</artifactId>
        </dependency>

        <!-- The cap-composition e2e starts from annotated sources, so the real annotation
             processor runs inside the test's javac invocation rather than being simulated. -->
        <dependency>
            <groupId>eu.exeris.tooling</groupId>
            <artifactId>exeris-processor</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Real Open-Core Kernel SPI on the test classpath: the codegen
             compile-test verifies emitted code resolves against actual
             exeris-kernel-spi types instead of legacy local stubs. -->
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-kernel-spi</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Open-Core Kernel CORE — KernelBootstrap + HttpRouter for the
             Application/RuntimeLifecycle compile gate. -->
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-kernel-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- SDK boot conductor: the compile gate emits a composed
             Application whose boot callback drives CompositionConductor —
             javac needs the real type, not a stub. -->
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-sdk-composition-runtime</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- A real kernel around the conductor run — the community driver supplies the
             HTTP provider, the testkit fixture boots it on a loopback port (http subsystem
             only; no database is involved). -->
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-kernel-community</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-kernel-community-testkit</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- GeneratedAppBootE2ETest boots the EMITTED Application with the events
             subsystem (for the SSE producer's bus) — which pulls persistence by dependency
             closure, and persistence needs a driver. In-memory H2, one database per run. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Jackson 3 (tools.jackson) on the test classpath, for the emitted
             REPOSITORY, not the handler: KernelRepositoryGenerator persists
             List<X> fields as JSON columns through ObjectMapper/TypeReference,
             and is the only emitter that names tools.jackson. Handlers stopped
             naming it at ADR-036, which moved request-body decode to the
             HttpRequestBodyDecoder SPI. Version managed via exeris-tooling-bom
             (jackson3.version). -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- CrudRouteParityE2ETest reads the OpenAPI paths as model objects, so the model types
             are declared rather than relied on as codegen-java transitives. -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-models</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- The opt-in @Tag("postgres") access matrix (SharedScopePostgresE2ETest)
             applies the emitted migrations to a real PostgreSQL, and is skipped unless
             -Dexeris.e2e.postgres.url is set. Test scope, in this module only, and deliberately
             not in exeris-tooling-bom: a consumer importing the BOM should inherit no driver
             opinion from tooling. 42.7.13 is the version exeris-kernel-bom 0.12.0 pins. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.13</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- T2: the generated-test gate runs the emitted tests in-process. -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- No preview flag. The composition e2e EXECUTES kernel classes rather
                         than only compiling against them, so a preview-stamped kernel class would
                         not load without one. The pinned kernel ships none (kernel ADR-066):
                         0 stamps across spi/core/community/community-testkit, all class-file
                         major 69. Adding the flag would pin the suite to one exact JDK. -->
                    <argLine>@{argLine}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>

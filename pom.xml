<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>eu.exeris.tooling</groupId>
    <artifactId>exeris-tooling-root</artifactId>
    <version>0.9.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Exeris Tooling :: Root</name>
    <description>
        Build-time tooling for the Exeris platform: annotation processor, code
        generators (kernel-target Java + Angular/TypeScript via separate npm
        package), and end-to-end conformance tests. Apache-2.0.
    </description>
    <!-- Every published module declares its own <url>. An inherited url gets the child's
         artifactId appended, and `child.project.url.inherit.append.path="false"` does not stop it
         on Maven 3.9 (effective POMs showed .../exeris-tooling/exeris-tooling-parent/exeris-processor
         with the attribute in place). The scm attributes below do work and stay. -->
    <url>https://github.com/exeris-systems/exeris-tooling</url>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>Exeris Systems</name>
        <url>https://exeris.eu</url>
    </organization>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>arkstack-dev</id>
            <name>Arkadiusz Przychocki</name>
            <email>oss@exeris.eu</email>
            <organization>Exeris Systems</organization>
            <organizationUrl>https://exeris.eu</organizationUrl>
        </developer>
    </developers>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/exeris-systems/exeris-tooling.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/exeris-systems/exeris-tooling.git</developerConnection>
        <url>https://github.com/exeris-systems/exeris-tooling</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/exeris-systems/exeris-tooling/issues</url>
    </issueManagement>

    <distributionManagement>
        <snapshotRepository>
            <id>central</id>
            <url>https://central.sonatype.com/repository/maven-snapshots</url>
        </snapshotRepository>
        <repository>
            <id>central</id>
            <url>https://central.sonatype.com</url>
        </repository>
    </distributionManagement>

    <!-- No <repositories>. Every POM this reactor publishes inherits from this one, and a repository
         declared here, in any profile included, is written into the deployed POM verbatim: Maven
         deploys the pom.xml as authored, not the effective model. A consumer resolving a published
         coordinate would then be pointed at a GitHub Packages registry that needs credentials, for
         artifacts Central already serves. A profile does not contain it either: a dependency POM's
         profiles are activated in the consumer's build, so one active by default, or by the absence
         of a property, is active there too.

         Every dependency resolves from Maven Central. If a build ever needs another repository,
         it belongs in a settings file, which never reaches a POM. -->

    <modules>
        <module>exeris-tooling-bom</module>
        <module>exeris-tooling-parent</module>

        <module>exeris-processor</module>
        <module>exeris-codegen-core</module>
        <module>exeris-codegen-java</module>
        <module>exeris-codegen-maven-plugin</module>
        <module>exeris-e2e-tests</module>

        <!-- ADR-091: the application BOM, parent and starter a consumer builds on, and the invoker
             fixture that builds an application on them. The first three have no parent in this
             reactor's chain (exeris-app-bom has none; the other two inherit it). -->
        <module>exeris-app-bom</module>
        <module>exeris-app-parent</module>
        <module>exeris-app-starter</module>
        <module>exeris-app-starter-it</module>

        <!-- Last on purpose: report-aggregate runs in verify and reads
             jacoco.exec from each dependency's target/ — every measured
             module must already have produced its exec by the time this
             module builds. -->
        <module>exeris-coverage-aggregate</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- JDK 25 LTS, per kernel ADR-066 / SDK ADR-069. Do not raise without a
             reason: exeris-codegen-maven-plugin loads into Maven's own JVM, so this
             release level is the floor a consumer's Maven must be able to read. -->
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <maven.compiler.release>25</maven.compiler.release>

        <!-- JaCoCo plugin version (build-plugin, not a dependency) — kept in
             the root POM so exeris-tooling-parent's pluginManagement can
             resolve ${jacoco.version}. BOM-imported properties do NOT
             propagate to <build><pluginManagement>, so this lives here
             rather than in exeris-tooling-bom. The check goal (threshold
             gate) is wired in exeris-tooling-parent and enforces
             85% line + 85% branch coverage on each reportable module
             (haltOnFailure=true). exeris-processor overrides this with
             a per-module 85% line + 80% branch rule — the relaxed branch
             reflects unreachable defensive null guards at the javac
             boundary; see exeris-processor/pom.xml for the rationale.
             No plugin-level excludes are needed. -->
        <jacoco.version>0.8.14</jacoco.version>

        <!-- Maven plugin development (exeris-codegen-maven-plugin, 0.3.0):
             plugin-api/core are provided-scope, plugin-tools provide the
             @Mojo annotation set + descriptor generator. Build-chain
             coordinates, kept here alongside ${jacoco.version}. -->
        <maven.api.version>3.9.9</maven.api.version>
        <maven-plugin-tools.version>3.13.1</maven-plugin-tools.version>
        <!-- ASM override for the plugin descriptor scanner — plugin-tools 3.13.1
             bundles a pre-Java-26 ASM that cannot read class major version 70. -->
        <asm.version>9.9.1</asm.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.1</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.4.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- D1: fail fast with one clear line when Maven runs on too old a JVM,
                 instead of the opaque classworlds UnsupportedClassVersionError realm
                 dump you get at plugin load, long before maven.compiler.release
                 matters. The range is open-ended at [25,) (25 or newer). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-jdk-and-maven</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                    <message>exeris-tooling requires Maven to run on JDK 25 or newer (the reactor emits class-file major 69, and exeris-codegen-maven-plugin loads into Maven's own JVM). Current JVM: ${java.version}.</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                    <message>exeris-tooling requires Maven 3.9+.</message>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
        Everything a Maven Central release needs, and nothing the ordinary build touches. Activated
        only by `-P release`; .github/workflows/release.yml is the one caller.

        Profile-scoped because central-publishing-maven-plugin declares <extensions>true</extensions>
        and takes over the `deploy` phase of every module it is declared for. Outside this profile it
        would own every `mvn deploy` this reactor runs.

        The shape follows exeris-kernel's and exeris-sdk's `release` profiles. The Central Portal
        replaced OSSRH on 2025-06-30; nexus-staging-maven-plugin and the oss.sonatype.org URLs no
        longer work.
    -->
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <!-- Central requires a sources jar beside every jar it accepts. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!--
                        Central requires a javadoc jar beside every jar it accepts; it does not
                        inspect its content. doclint is off and failOnError false because no
                        javadoc gate holds these modules' prose, and the ability to publish must not
                        depend on ungated prose. What does gate the release is the jar's presence:
                        tools/release-readiness fails a published jar with no javadoc jar beside it,
                        which is where a javadoc run that failed quietly here surfaces.

                        The three OpenJDK contract tags are registered because an unregistered
                        custom tag under `doclint none` is a swallowed warning, and its body is then
                        dropped from the page.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <doclint>none</doclint>
                            <failOnError>false</failOnError>
                            <quiet>true</quiet>
                            <tags>
                                <tag><name>apiNote</name><placement>a</placement><head>API Note:</head></tag>
                                <tag><name>implSpec</name><placement>a</placement><head>Implementation Requirements:</head></tag>
                                <tag><name>implNote</name><placement>a</placement><head>Implementation Note:</head></tag>
                            </tags>
                        </configuration>
                    </plugin>

                    <!--
                        Central verifies a detached GPG signature on every file it accepts: jar,
                        sources, javadoc and pom.

                        No `gpgArguments`. With a passphrase available the plugin already passes
                        loopback pinentry and a passphrase file descriptor itself; without one it
                        appends `pinentry-mode error` after any supplied argument, and gpg honours
                        the last occurrence. The passphrase arrives through the environment variable
                        named by `passphraseEnvName`, which actions/setup-java's `gpg-passphrase`
                        input sets in the settings.xml it generates. release.yml names it
                        MAVEN_GPG_PASSPHRASE in both places; when the two names differ, signing fails
                        with "gpg: signing failed: No pinentry", which names neither.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!--
                        autoPublish=false: the upload creates a deployment that a person publishes
                        in the Central Portal after reading its validation results. A deployment can
                        be dropped until then; a published release can never be changed.
                        waitUntil=validated makes the build wait for that validation, so a coordinate
                        Central rejects fails the workflow instead of sitting in the portal.

                        <excludeArtifacts> and each excluded module's own maven.deploy.skip name the
                        same modules and are not duplicates. maven.deploy.skip is read by
                        maven-deploy-plugin, which this plugin replaces; this plugin does not read
                        it, and without the exclusion it stages the module's jar and pom into the
                        upload, where a jar with no sources and javadoc beside it fails Central's
                        validation of the whole deployment. tools/release-readiness asserts the two
                        lists agree.

                        exeris-app-bom declares this plugin again, in its `exeris-tooling-release`
                        profile, for itself and the two modules that inherit it (ADR-091). The two
                        declarations must not differ in anything but <excludeArtifacts>, and each
                        list covers only the modules whose parent chain reaches its POM;
                        tools/release-readiness checks both.
                    -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                            <excludeArtifacts>
                                <artifact>exeris-e2e-tests</artifact>
                                <artifact>exeris-coverage-aggregate</artifact>
                                <artifact>exeris-app-starter-it</artifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.exeris.tooling</groupId>
        <artifactId>exeris-tooling-root</artifactId>
        <version>0.9.0-SNAPSHOT</version>
    </parent>

    <artifactId>exeris-tooling-bom</artifactId>
    <packaging>pom</packaging>

    <name>Exeris Tooling :: BOM</name>
    <description>Bill of materials for tooling modules and third-party deps.</description>
    <url>https://github.com/exeris-systems/exeris-tooling</url>

    <properties>
        <!--
          SDK 0.12.0, the final release on Maven Central (tag `v0.12.0`), the
          line that pairs with kernel 0.12.0. Both Exeris pins are releases, as
          the released-pins rule requires of a tooling cut (ROADMAP "Versioning
          policy"), and both resolve from Central with no settings file.

          How this repo reads SDK 0.12's records: a record grows by a trailing
          component, and builders are the stable path. `DomainMetadata`,
          `ActionMetadata` and `SystemFieldsMetadata` are built through their
          builders. `SystemFieldsMetadata.sharedScopeField` (the `@SharedScope`
          carrier) is filled only for a `DataScope.UNIVERSE` entity and is
          `null` everywhere else, which `@JsonInclude(NON_NULL)` keeps off the
          wire. The `schemaVersion` the processor stamps follows
          `SchemaVersion.CURRENT`. `@Channel` and `@RouteAccess` are read by
          nothing yet.
        -->
        <exeris.sdk.version>0.12.0</exeris.sdk.version>
        <!--
          Kernel 0.12.0 — the line SDK 0.12 pairs with, and the floor for three
          things the emitters name:

          - `FlowDefinitionBuilder.version(int)` (a `default` method, ADR-064
            amendment), which the generated `*SagaFlow` calls for a declared
            `@Saga.version`.
          - `ConnectionInterceptor.SESSION_KEY_TENANT_ID` and
            `SESSION_KEY_SHARED_SCOPE`, the RLS session variables as SPI
            contract rather than one driver's literal. The emitted migrations
            name them as literals, and `SharedScopeSqlE2ETest` checks each
            literal against its constant.
          - ADR-074 peer addressing. A CLIENT-mode `HttpConfig`'s `bindHost` /
            `port` are never dialled; the peer is `defaultAuthority`
            (`http.client.defaultAuthority`) or `KernelWebClient.withAuthority`,
            as the emitted `*Client` Javadoc says.

          The ADR-066 baseline holds: the spi, core, community and
          community-testkit jars are class-file major 69 with zero preview
          stamps.

          Take the `eu.exeris` coordinates, never `eu.exeris.preview` (the
          JDK 28 EA Valhalla line). Choosing a line is a build-matrix question,
          never a codegen fork: of the kernel types the emitters name, only
          `EventBus` (Javadoc) and `MemoryStats` (the `value` modifier) differ,
          and neither difference reaches a consumer.
        -->
        <exeris.kernel.version>0.12.0</exeris.kernel.version>

        <auto-service.version>1.1.1</auto-service.version>
        <palantir.javapoet.version>0.15.0</palantir.javapoet.version>
        <!-- 2.18.9 closes the jackson-databind advisories Dependabot raises against
             2.18.x. Patch-level, no API change. -->
        <jackson.version>2.18.9</jackson.version>
        <!-- The Jackson 3 version the pinned kernel pins (exeris-kernel-bom); it moves with
             the kernel pin. The comment below says this dep tracks "the same Jackson 3 line
             the Open-Core kernel runtime uses", and management here beats the kernel's own
             transitive version, so a value a minor behind the kernel would run kernel classes
             in the e2e suite on an older Jackson than they were built against, and the compile
             gate would check emitted `tools.jackson.*` references against the wrong minor.
             Patch-ahead of the kernel inside its minor is acceptable for a security bump; a
             minor behind is not. -->
        <jackson3.version>3.2.2</jackson3.version>
        <swagger-parser.version>2.1.45</swagger-parser.version>
        <!-- swagger-core carries the OpenAPI model types and the 3.1 mappers this module
             compiles against directly. It arrives transitively through swagger-parser, so
             this pin must track what that version resolves rather than move on its own:
             swagger-parser-project-2.1.45.pom declares <swagger-core-version>2.2.52 at
             line 378, which is where the number below comes from. Declaring it keeps a
             transitive reshuffle from breaking the build silently. -->
        <swagger-core.version>2.2.52</swagger-core.version>

        <junit.version>5.11.4</junit.version>
        <!-- 3.27.7 is the floor: it closes GHSA-rqfh-9r24-8c9r — XXE in isXmlEqualTo when
             parsing untrusted XML. We do not use isXmlEqualTo anywhere
             in the test suite (`grep -r isXmlEqualTo` → zero hits), so
             the vulnerability is structurally non-exploitable here; the
             pin keeps the dep line on a patched version. -->
        <assertj.version>3.27.7</assertj.version>
        <compile-testing.version>0.21.0</compile-testing.version>
        <!-- The JDBC driver the kernel testkit's persistence needs when the e2e suite boots the
             EMITTED Application with the events/flow subsystems: both declare
             dependsOn("persistence"), and the testkit deliberately ships no driver. Same
             version the pinned exeris-kernel-community uses for its own H2 tests, so the
             kernel's persistence has been exercised on exactly this driver. Test scope only —
             emitted code never names it. -->
        <h2.version>2.3.232</h2.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Exeris SDK -->
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-sdk-annotations</artifactId>
                <version>${exeris.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-sdk-source-model</artifactId>
                <version>${exeris.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-sdk-composition-spec</artifactId>
                <version>${exeris.sdk.version}</version>
            </dependency>
            <!-- SDK boot conductor — not a codegen dependency (the emitter only
                 writes its FQN); needed on the e2e compile gate's test classpath
                 so the composed Application resolves CompositionConductor. -->
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-sdk-composition-runtime</artifactId>
                <version>${exeris.sdk.version}</version>
            </dependency>

            <!-- Exeris Kernel Open-Core SPI — required by the codegen
                 compile-test to verify emitted code resolves against real
                 SPI types (HttpExchange, HttpStatus, LoanedBuffer, etc.)
                 instead of local stubs. -->
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-kernel-spi</artifactId>
                <version>${exeris.kernel.version}</version>
            </dependency>

            <!-- Exeris Kernel Open-Core CORE — required by the Application
                 emission compile-test for core.bootstrap.KernelBootstrap and
                 core.http.routing.HttpRouter. -->
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-kernel-core</artifactId>
                <version>${exeris.kernel.version}</version>
            </dependency>

            <!-- Community driver + its test fixture — the cap-composition e2e boots a
                 real kernel (http subsystem only) around the conductor run. -->
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-kernel-community</artifactId>
                <version>${exeris.kernel.version}</version>
            </dependency>
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-kernel-community-testkit</artifactId>
                <version>${exeris.kernel.version}</version>
            </dependency>

            <!-- Internal tooling modules -->
            <dependency>
                <groupId>eu.exeris.tooling</groupId>
                <artifactId>exeris-diagnostics</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>eu.exeris.tooling</groupId>
                <artifactId>exeris-processor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>eu.exeris.tooling</groupId>
                <artifactId>exeris-codegen-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>eu.exeris.tooling</groupId>
                <artifactId>exeris-codegen-java</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Google Auto Service (annotation processor self-registration) -->
            <dependency>
                <groupId>com.google.auto.service</groupId>
                <artifactId>auto-service</artifactId>
                <version>${auto-service.version}</version>
            </dependency>

            <!-- JavaPoet (type-safe Java source emission for codegen-java;
                 ADR-015 Amendment 1: Palantir's maintained fork — adds record support
                 for Phase 4c KernelEventGenerator) -->
            <dependency>
                <groupId>com.palantir.javapoet</groupId>
                <artifactId>javapoet</artifactId>
                <version>${palantir.javapoet.version}</version>
            </dependency>

            <!-- Jackson 2.x (build-time JSON I/O for metadata files) -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.datatype</groupId>
                <artifactId>jackson-datatype-jsr310</artifactId>
                <version>${jackson.version}</version>
            </dependency>

            <!-- Jackson 3 (tools.jackson) — test-scoped: codegen compile-test
                 verifies emitted repositories' tools.jackson.* references
                 (List<X> JSON-column persistence via ObjectMapper / TypeReference,
                 see KernelRepositoryGenerator) resolve against the same Jackson 3
                 line the Open-Core kernel runtime uses. Only repositories reference
                 it; handlers use the HttpRequestBodyDecoder SPI (per ADR-036).
                 Not pulled by production tooling modules. -->
            <dependency>
                <groupId>tools.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson3.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.dataformat</groupId>
                <artifactId>jackson-dataformat-yaml</artifactId>
                <version>${jackson.version}</version>
            </dependency>

            <!-- Swagger Parser (OpenAPI 3 emission) -->
            <dependency>
                <groupId>io.swagger.parser.v3</groupId>
                <artifactId>swagger-parser</artifactId>
                <version>${swagger-parser.version}</version>
            </dependency>
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-core</artifactId>
                <version>${swagger-core.version}</version>
            </dependency>
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-models</artifactId>
                <version>${swagger-core.version}</version>
            </dependency>

            <!-- Test deps -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- Programmatic JUnit execution — the T2 gate does not just compile the
                 generated tests, it RUNS them (a test emitter whose output is never
                 executed is exactly the inert-output failure mode). Platform version
                 tracks the Jupiter one: 5.x.y ↔ platform 1.x.y. -->
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-launcher</artifactId>
                <version>1.11.4</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.google.testing.compile</groupId>
                <artifactId>compile-testing</artifactId>
                <version>${compile-testing.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.exeris.tooling</groupId>
        <artifactId>exeris-tooling-root</artifactId>
        <version>0.7.0</version>
    </parent>

    <artifactId>exeris-tooling-bom</artifactId>
    <packaging>pom</packaging>

    <name>Exeris Tooling :: BOM</name>
    <description>Bill of materials for tooling modules and third-party deps.</description>

    <properties>
        <!--
          Released pins (U0). The SNAPSHOT window the ADR-059 slice-A work opened
          is closed: SDK 0.10.0 ships `dataScope`, the AST-owned `DataScope` and
          `DomainMetadata.effectiveDataScope()`. Nothing here may go back to a
          SNAPSHOT — a cross-repo SNAPSHOT blocks cutting any release at all.
        -->
        <exeris.sdk.version>0.10.0</exeris.sdk.version>
        <!--
          Kernel 0.11.0 — the line SDK 0.10 pairs with (the `sharedScopeKey`
          carrier behind `DataScope.UNIVERSE`, consumed by ADR-059 slice B).

          Load-bearing for what comes next: 0.11.0 is the first kernel whose
          distributed artifacts are class-file **major 69** with zero preview
          stamps (kernel ADR-066). 0.10.2 was major 70 and `exeris-kernel-core`
          carried 9 preview-stamped classes, which JDK 25 refuses outright — so
          this bump is a hard prerequisite for the JDK-25 LTS descent (U1), not
          merely adjacent to it. Verified by reading the jars, not the notes.

          0.11.0 also ships as `eu.exeris.preview:*:0.11.0` (JDK 28 EA, Valhalla
          `value record`). That line is deliberately NOT consumed here: the
          emitted source is identical across both (of the 46 kernel types the
          emitters name, only `EventBus` — javadoc-only — and `MemoryStats` —
          the `value` modifier, transparent to a consumer — differ), so choosing
          a line is a build-matrix question, never a codegen fork.
        -->
        <exeris.kernel.version>0.11.0</exeris.kernel.version>

        <auto-service.version>1.1.1</auto-service.version>
        <palantir.javapoet.version>0.15.0</palantir.javapoet.version>
        <!-- 2.18.9 closes the jackson-databind advisories Dependabot raises against
             2.18.x. Patch-level, no API change. -->
        <jackson.version>2.18.9</jackson.version>
        <!-- 3.1.5 does two things at once, and the second is the one worth reading.

             It closes the tools.jackson advisories (everything <= 3.1.4 is affected).
             It also ends a drift: this property said 3.0.4 while BOTH kernel 0.10.2 and
             0.11.0 pin Jackson 3 at 3.1.1 — a whole minor apart. The comment below
             claims this dep tracks "the same Jackson 3 line the Open-Core kernel runtime
             uses", and that had quietly stopped being true, which means the compile gate
             was checking emitted `tools.jackson.*` references against a different minor
             than the kernel actually runs. Being patch-ahead of the kernel inside 3.1 is
             the right posture for a security bump; being a minor behind was not a
             posture at all. -->
        <jackson3.version>3.1.5</jackson3.version>
        <swagger-parser.version>2.1.45</swagger-parser.version>

        <junit.version>5.11.4</junit.version>
        <!-- 3.27.7 closes GHSA-rqfh-9r24-8c9r — XXE in isXmlEqualTo when
             parsing untrusted XML. We do not use isXmlEqualTo anywhere
             in the test suite (`grep -r isXmlEqualTo` → zero hits), so
             the vulnerability is structurally non-exploitable here; the
             bump is purely to close the Dependabot alert and keep the
             dep line on a patched version. Patch-level bump (3.27.3 →
             3.27.7), no API change. -->
        <assertj.version>3.27.7</assertj.version>
        <compile-testing.version>0.21.0</compile-testing.version>
        <json-schema-validator.version>1.5.4</json-schema-validator.version>
        <approvaltests.version>24.16.0</approvaltests.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Exeris SDK -->
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-sdk-annotations</artifactId>
                <version>${exeris.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-sdk-source-model</artifactId>
                <version>${exeris.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-sdk-composition-spec</artifactId>
                <version>${exeris.sdk.version}</version>
            </dependency>
            <!-- SDK boot conductor — not a codegen dependency (the emitter only
                 writes its FQN); needed on the e2e compile gate's test classpath
                 so the G2 composed Application resolves CompositionConductor. -->
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-sdk-composition-runtime</artifactId>
                <version>${exeris.sdk.version}</version>
            </dependency>

            <!-- Exeris Kernel Open-Core SPI — required by the codegen
                 compile-test to verify emitted code resolves against real
                 SPI types (HttpExchange, HttpStatus, LoanedBuffer, etc.)
                 instead of local stubs. -->
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-kernel-spi</artifactId>
                <version>${exeris.kernel.version}</version>
            </dependency>

            <!-- Exeris Kernel Open-Core CORE — required by the Application
                 emission compile-test for core.bootstrap.KernelBootstrap and
                 core.http.routing.HttpRouter. -->
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-kernel-core</artifactId>
                <version>${exeris.kernel.version}</version>
            </dependency>

            <!-- Community driver + its test fixture — the G3 composition e2e boots a
                 real kernel (http subsystem only) around the conductor run. -->
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-kernel-community</artifactId>
                <version>${exeris.kernel.version}</version>
            </dependency>
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-kernel-community-testkit</artifactId>
                <version>${exeris.kernel.version}</version>
            </dependency>

            <!-- Internal tooling modules -->
            <dependency>
                <groupId>eu.exeris.tooling</groupId>
                <artifactId>exeris-processor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>eu.exeris.tooling</groupId>
                <artifactId>exeris-codegen-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>eu.exeris.tooling</groupId>
                <artifactId>exeris-codegen-java</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Google Auto Service (annotation processor self-registration) -->
            <dependency>
                <groupId>com.google.auto.service</groupId>
                <artifactId>auto-service</artifactId>
                <version>${auto-service.version}</version>
            </dependency>

            <!-- JavaPoet (type-safe Java source emission for codegen-java;
                 ADR-015 Amendment 1: Palantir's maintained fork — adds record support
                 for Phase 4c KernelEventGenerator) -->
            <dependency>
                <groupId>com.palantir.javapoet</groupId>
                <artifactId>javapoet</artifactId>
                <version>${palantir.javapoet.version}</version>
            </dependency>

            <!-- Jackson 2.x (build-time JSON I/O for metadata files) -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.datatype</groupId>
                <artifactId>jackson-datatype-jsr310</artifactId>
                <version>${jackson.version}</version>
            </dependency>

            <!-- Jackson 3 (tools.jackson) — test-scoped: codegen compile-test
                 verifies emitted repositories' tools.jackson.* references
                 (List<X> JSON-column persistence via ObjectMapper / TypeReference,
                 see KernelRepositoryGenerator) resolve against the same Jackson 3
                 line the Open-Core kernel runtime uses. Handlers no longer
                 reference it — ADR-036 moved request-body decode to the
                 HttpRequestBodyDecoder SPI. Not pulled by production tooling
                 modules. -->
            <dependency>
                <groupId>tools.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson3.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.dataformat</groupId>
                <artifactId>jackson-dataformat-yaml</artifactId>
                <version>${jackson.version}</version>
            </dependency>

            <!-- Swagger Parser (OpenAPI 3 emission) -->
            <dependency>
                <groupId>io.swagger.parser.v3</groupId>
                <artifactId>swagger-parser</artifactId>
                <version>${swagger-parser.version}</version>
            </dependency>

            <!-- Test deps -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- Programmatic JUnit execution — the T2 gate does not just compile the
                 generated tests, it RUNS them (a test emitter whose output is never
                 executed is exactly the inert-output failure mode). Platform version
                 tracks the Jupiter one: 5.x.y ↔ platform 1.x.y. -->
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-launcher</artifactId>
                <version>1.11.4</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.google.testing.compile</groupId>
                <artifactId>compile-testing</artifactId>
                <version>${compile-testing.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.networknt</groupId>
                <artifactId>json-schema-validator</artifactId>
                <version>${json-schema-validator.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.approvaltests</groupId>
                <artifactId>approvaltests</artifactId>
                <version>${approvaltests.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>

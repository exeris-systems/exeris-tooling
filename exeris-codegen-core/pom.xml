<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.exeris</groupId>
        <artifactId>exeris-tooling-parent</artifactId>
        <version>0.10.0-SNAPSHOT</version>
        <relativePath>../exeris-tooling-parent</relativePath>
    </parent>

    <artifactId>exeris-codegen-core</artifactId>
    <packaging>jar</packaging>
    <name>Exeris Tooling :: Codegen Core</name>
    <description>
        Shared code-generation infrastructure: metadata loading from
        exeris-metadata/*.json, generator registry, and shared utilities.
        Target: Exeris kernel only.
    </description>
    <url>https://github.com/exeris-systems/exeris-tooling</url>

    <!-- Lint enforced: a Checkstyle or PMD finding in this module's main sources fails the build;
         the parent's default is warn-only. -->
    <properties>
        <checkstyle.failOnViolation>true</checkstyle.failOnViolation>
        <checkstyle.failsOnError>true</checkstyle.failsOnError>
        <pmd.failOnViolation>true</pmd.failOnViolation>
        <!-- exeris-tooling-parent: the host-framework and kernel-runtime dependency ban. -->
        <exeris.ban-host-and-kernel-runtime.skip>false</exeris.ban-host-and-kernel-runtime.skip>
    </properties>

    <dependencies>
        <!-- Canonical metadata records consumed by all generators -->
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-sdk-source-model</artifactId>
        </dependency>

        <!-- The ONE canonical ADR-024 content-binding (obligation 8b). The tooling emits the
             binding; the SKU-boot runtime asserts it; both delegate to this shared definition
             instead of each maintaining a byte-verbatim copy. -->
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-sdk-composition-spec</artifactId>
        </dependency>

        <!-- Jackson for metadata loading -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>


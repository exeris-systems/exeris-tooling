<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.exeris</groupId>
        <artifactId>exeris-tooling-root</artifactId>
        <version>0.10.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>exeris-tooling-parent</artifactId>
    <packaging>pom</packaging>

    <name>Exeris Tooling :: Parent</name>
    <description>Common build configuration for Exeris tooling modules.</description>
    <url>https://github.com/exeris-systems/exeris-tooling</url>

    <properties>
        <!-- The ban-host-and-kernel-runtime enforcer execution below runs in the modules that set
             this to false: exeris-processor, exeris-codegen-core and exeris-codegen-java. -->
        <exeris.ban-host-and-kernel-runtime.skip>true</exeris.ban-host-and-kernel-runtime.skip>

        <!--
            Lint of the tooling's own main sources: Checkstyle at validate, PMD at verify, with the
            rulesets in config/ at the reactor root. Bound here and nowhere else in the chain:
            exeris-app-bom has no parent and exeris-app-parent / exeris-app-starter inherit it, so a
            consumer application never reaches this POM and never runs these rules.

            ${maven.multiModuleProjectDirectory} is the directory holding .mvn/, which is why the
            reactor root carries one: without it the variable falls back to the working directory, and
            a build started inside a module would look for config/ there.

            Each setting is a property, and the plugin configuration below reads the property rather
            than holding a literal. An explicit literal beats the plugin's own user property silently,
            so `-Dcheckstyle.config.location=...` or `-Dpmd.failOnViolation=true` would neither apply
            nor fail. A module that is made clean flips its own failOnViolation property to true.
        -->
        <exeris.lint.config.dir>${maven.multiModuleProjectDirectory}/config</exeris.lint.config.dir>
        <checkstyle.config.location>${exeris.lint.config.dir}/checkstyle/checkstyle.xml</checkstyle.config.location>
        <checkstyle.suppressions.location>${exeris.lint.config.dir}/checkstyle/suppressions.xml</checkstyle.suppressions.location>
        <exeris.pmd.ruleset>${exeris.lint.config.dir}/pmd/pmd-ruleset.xml</exeris.pmd.ruleset>
        <checkstyle.failOnViolation>false</checkstyle.failOnViolation>
        <checkstyle.failsOnError>false</checkstyle.failsOnError>
        <pmd.failOnViolation>false</pmd.failOnViolation>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-tooling-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- JaCoCo plugin version pinned via the root POM property
                     ${jacoco.version} (not a BOM-managed dependency — plugin
                     coordinates live on the build chain, not on
                     dependencyManagement). Active configuration applied
                     below in <plugins>. -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <!-- kernel-target-only.md and processor-build-time-only.md, held on the resolved
                 dependency graph, every scope and every transitive edge: no host framework, and
                 none of the kernel's runtime (core, the community driver and its testkit). The
                 kernel SPI is the contract emitted code is written against, and stays allowed.
                 The JDK-provided compiler APIs are outside Maven's reach; the ArchUnit tests in
                 each module hold those. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-host-and-kernel-runtime</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <skip>${exeris.ban-host-and-kernel-runtime.skip}</skip>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>org.springframework*</exclude>
                                        <exclude>io.quarkus*</exclude>
                                        <exclude>io.micronaut*</exclude>
                                        <exclude>eu.exeris:exeris-kernel-core</exclude>
                                        <exclude>eu.exeris:exeris-kernel-community*</exclude>
                                    </excludes>
                                    <message>${project.artifactId} targets the Exeris kernel at build time only: no host framework and no kernel runtime on its dependency graph (.agents/policies/kernel-target-only.md, processor-build-time-only.md).</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Plugin and engine versions match exeris-kernel-parent; the engine is pinned because
                 the plugin's default Checkstyle predates record patterns. Main sources only:
                 sourceDirectories excludes generated-sources, which no person writes. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>13.11.0</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>${checkstyle.config.location}</configLocation>
                    <suppressionsLocation>${checkstyle.suppressions.location}</suppressionsLocation>
                    <sourceDirectories>
                        <sourceDirectory>${project.build.sourceDirectory}</sourceDirectory>
                    </sourceDirectories>
                    <includeResources>false</includeResources>
                    <includeTestResources>false</includeTestResources>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>${checkstyle.failOnViolation}</failOnViolation>
                    <failsOnError>${checkstyle.failsOnError}</failsOnError>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle-validate</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- check forks pmd:pmd; at verify the classes exist, so type-resolving rules
                 (UnusedPrivateMethod, CloseResource) see the auxclasspath. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>3.28.0</version>
                <dependencies>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-core</artifactId>
                        <version>7.28.0</version>
                    </dependency>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-java</artifactId>
                        <version>7.28.0</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <rulesets>
                        <ruleset>${exeris.pmd.ruleset}</ruleset>
                    </rulesets>
                    <compileSourceRoots>
                        <compileSourceRoot>${project.build.sourceDirectory}</compileSourceRoot>
                    </compileSourceRoots>
                    <targetJdk>25</targetJdk>
                    <linkXRef>false</linkXRef>
                    <printFailingErrors>true</printFailingErrors>
                    <failOnViolation>${pmd.failOnViolation}</failOnViolation>
                </configuration>
                <executions>
                    <execution>
                        <id>pmd-verify</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Coverage: prepare-agent attaches the JaCoCo runtime agent so
                 surefire-driven JUnit runs are instrumented; report emits
                 HTML + XML + CSV under target/site/jacoco of each module;
                 check enforces the 85% line + branch threshold and halts
                 the build on violation.

                 No plugin-level excludes. The earlier CodegenMain.class
                 exclude was dropped after the CLI shell was split into
                 CliArgs + CodegenPipeline + a one-line main(); the
                 split surface is fully unit-tested.

                 Note on cross-module coverage: exeris-e2e-tests has no
                 src/main/java, so report is skipped there ("missing
                 classes directory") — but the agent still runs and an
                 exec file is captured at target/jacoco.exec. Coverage of
                 codegen-java classes exercised by e2e-tests does NOT
                 fold into exeris-codegen-java's per-module report;
                 the exeris-coverage-aggregate module owns that fold,
                 emitting a combined report at
                 exeris-coverage-aggregate/target/site/jacoco-aggregate/.
                 The per-module gates here remain authoritative (regression
                 protection when a module is tested in isolation); the
                 aggregate is informational only and has no check rule.

                 Note on exeris-processor: its child pom overrides the
                 inherited check rule with a per-module 85% line + 80%
                 branch threshold. The relaxed branch rule reflects
                 unreachable defensive null guards at the javac
                 boundary; see exeris-processor/pom.xml for the in-pom
                 rationale. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <haltOnFailure>true</haltOnFailure>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.85</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.85</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
